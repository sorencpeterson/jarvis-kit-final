{
  "type": "object",
  "required": ["headline", "diagnosis_title", "personal_line", "faults", "scope", "faq",
               "email_subject", "email_body", "avg_job", "mockup"],
  "properties": {
    "headline": {"type": "string", "minLength": 1},
    "diagnosis_title": {"type": "string", "minLength": 1},
    "personal_line": {"type": "string"},
    "faults": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["t", "p"],
        "properties": {"t": {"type": "string"}, "p": {"type": "string"}}
      }
    },
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "faq": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["q", "a"],
        "properties": {"q": {"type": "string"}, "a": {"type": "string"}}
      }
    },
    "email_subject": {"type": "string", "minLength": 1},
    "email_body": {"type": "string", "minLength": 1},
    "tier_bump": {"type": ["number", "null"]},
    "bump_reason": {"type": "string"},
    "avg_job": {"type": ["number", "string"]},
    "mockup": {
      "type": "object",
      "required": ["hero_h", "hero_sub", "cta_main", "services"],
      "properties": {
        "hero_h": {"type": "string"},
        "hero_sub": {"type": "string"},
        "cta_main": {"type": "string"},
        "cta_alt": {"type": "string"},
        "trust": {"type": "array", "items": {"type": "string"}},
        "form_head": {"type": "string"},
        "form_sub": {"type": "string"},
        "form_field3": {"type": "string"},
        "form_btn": {"type": "string"},
        "services_h": {"type": "string"},
        "services_sub": {"type": "string"},
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["t", "p"],
            "properties": {"icon": {"type": "string"}, "t": {"type": "string"}, "p": {"type": "string"}}
          }
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"n": {"type": "string"}, "l": {"type": "string"}}
          }
        },
        "cta_band_h": {"type": "string"},
        "cta_band_sub": {"type": "string"},
        "area_line": {"type": "string"}
      }
    }
  },
  "_note": "Has-site salon prospect (booking-niche). Same shape as proposal_gen_01 but exercises the has-site evidence path and tier_bump nonzero possibility with bump_reason."
}
