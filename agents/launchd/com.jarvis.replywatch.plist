<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.replywatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__INSTALL_DIR__/.venv/bin/python</string>
    <string>__INSTALL_DIR__/agents/reply_watch.py</string>
  </array>
  <key>WorkingDirectory</key><string>__INSTALL_DIR__</string>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>__INSTALL_DIR__/agents/replywatch.log</string>
  <key>StandardOutPath</key><string>__INSTALL_DIR__/agents/replywatch.log</string>
</dict>
</plist>
