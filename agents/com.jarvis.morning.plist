<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the morning routine (triage + 3 moves + brief) every day at 6:30am.
  Enable once (your hands — same as the refresh timer):

    cp agents/com.jarvis.morning.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jarvis.morning.plist

  Disable:
    launchctl bootout gui/$(id -u)/com.jarvis.morning
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.morning</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__INSTALL_DIR__/agents/morning.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardErrorPath</key><string>__INSTALL_DIR__/agents/morning.err.log</string>
  <key>StandardOutPath</key><string>__INSTALL_DIR__/agents/morning.out.log</string>
</dict>
</plist>
